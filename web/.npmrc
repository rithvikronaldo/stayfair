# React 19 is newer than several deps' peer-dep ranges (@visx/* still claims
# react@^16|^17|^18). The libraries themselves work with React 19; only their
# peer metadata is stale. legacy-peer-deps=true tells npm to mirror npm v6
# behaviour and not error out on those — what Vercel's strict install needs
# to succeed.
legacy-peer-deps=true
